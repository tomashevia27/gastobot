generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  FOOD
  SUPERMARKET
  TRANSPORT
  FUEL
  OUTINGS
  EDUCATION
  HEALTH
  SERVICES
  OTHER
  UNCATEGORIZED
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
  DEBIT
  CREDIT
  TRANSFER
  OTHER
}

enum Currency {
  ARS
}

enum ExpenseSource {
  MANUAL_WEB
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  amountCents   BigInt          @map("amount_cents")
  currency      Currency        @default(ARS)
  occurredOn    DateTime        @db.Date @map("occurred_on")
  category      ExpenseCategory @default(UNCATEGORIZED)
  paymentMethod PaymentMethod   @map("payment_method")
  merchant      String?         @db.VarChar(120)
  description   String?         @db.VarChar(500)
  source        ExpenseSource   @default(MANUAL_WEB)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@index([occurredOn(sort: Desc), createdAt(sort: Desc), id], map: "expenses_list_order_idx")
  @@map("expenses")
}
